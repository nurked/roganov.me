---
import { getCollection } from 'astro:content';
import { useTranslations, getLocalePath } from '../i18n/utils.js';

interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);

// Live-compute stats so claims age automatically with the site.
const posts = await getCollection('blog', ({ data }) => {
  return data.lang === lang && !data.draft;
});
const articleCount = posts.length;
const yearsCoding = new Date().getFullYear() - 1999;

const blogHref = getLocalePath(lang, 'blog/');

const stats = lang === 'ru'
  ? [
      { value: `${yearsCoding}+`, label: 'лет пишу код', href: null },
      { value: `${articleCount}+`, label: 'статей в блоге', href: blogHref },
      { value: '6', label: 'лет преподаю', href: null },
      { value: '3', label: 'компании основал', href: null },
    ]
  : [
      { value: `${yearsCoding}+`, label: 'Years coding', href: null },
      { value: `${articleCount}+`, label: 'Articles published', href: blogHref },
      { value: '6', label: 'Years teaching', href: null },
      { value: '3', label: 'Companies founded', href: null },
    ];
---

<div class="relative w-full min-h-[calc(100vh_-_60px)] flex items-center justify-center overflow-hidden">
  <!-- Floating gradient orbs -->
  <div class="absolute top-1/4 -left-32 w-96 h-96 bg-brand/20 rounded-full blur-[128px] pointer-events-none"></div>
  <div class="absolute bottom-1/4 -right-32 w-96 h-96 bg-brand-accent/15 rounded-full blur-[128px] pointer-events-none"></div>
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-brand/10 rounded-full blur-[128px] pointer-events-none"></div>

  <!-- Dot grid pattern overlay -->
  <div class="absolute inset-0 opacity-[0.03]" style="background-image: radial-gradient(circle, white 1px, transparent 1px); background-size: 32px 32px;"></div>

  <div class="relative z-10 flex flex-col items-center justify-center p-6 md:p-16 space-y-8 max-w-5xl mx-auto text-center">
    <!-- Availability badge -->
    <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full glass text-sm text-gray-300">
      <span class="relative flex h-2.5 w-2.5">
        <span class="animate-pulse-dot absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-green-500"></span>
      </span>
      {lang === 'ru' ? 'Доступен для проектов' : 'Available for Projects'}
    </div>

    <!-- Main heading -->
    <div class="space-y-4">
      <h1 class="text-5xl md:text-7xl font-bold text-white tracking-tight leading-tight">
        {t('hero.greeting')}
      </h1>
      <h2 class="text-2xl md:text-3xl text-gray-300 font-light max-w-2xl mx-auto">
        {t('hero.subtitle')}
      </h2>
      <p class="text-xl md:text-2xl text-gradient font-semibold">
        {t('hero.cta')}
      </p>
    </div>

    <!-- CTA buttons -->
    <div class="flex flex-col sm:flex-row gap-4 mt-4">
      <a href="#contact" class="px-8 py-3 bg-brand hover:bg-brand-light text-white font-medium rounded-lg transition-all duration-300 hover:shadow-brand">
        {lang === 'ru' ? 'Связаться' : 'Get in Touch'}
      </a>
      <a href="#portfolio" class="px-8 py-3 border border-white/20 hover:border-white/40 text-gray-300 hover:text-white font-medium rounded-lg transition-all duration-300">
        {lang === 'ru' ? 'Портфолио' : 'View Portfolio'}
      </a>
    </div>

    <!-- SkyPeck promo — intentionally loud -->
    <a
      href="https://skypeck.fun"
      target="_blank"
      rel="noopener"
      class="skypeck-promo group relative inline-flex items-center gap-4 md:gap-5 mt-6 pl-5 pr-10 md:pr-14 py-4 md:py-5 rounded-2xl -rotate-2 hover:rotate-1 hover:scale-105 transition-transform duration-300"
    >
      <img
        src="/img/skypeck.png"
        alt=""
        width="96"
        height="96"
        class="w-14 h-14 md:w-20 md:h-20 rounded-full border-4 border-white/80 shadow-xl animate-bounce"
      />
      <span class="text-left leading-tight">
        <span class="block text-xl md:text-3xl font-extrabold uppercase tracking-wide text-[#052e0f]">
          {lang === 'ru' ? 'Играть в SkyPeck!' : 'Play SkyPeck!'}
        </span>
        <span class="block text-sm md:text-base font-semibold text-[#0a4d1c]">
          {lang === 'ru' ? 'Моя новая игра — попугай ждёт' : 'My new game — the parrot is waiting'}
        </span>
      </span>
      <span class="absolute -top-3 -right-3 rotate-12 bg-red-500 text-white text-xs md:text-sm font-black px-3 py-1 rounded-full shadow-lg animate-pulse">
        {lang === 'ru' ? 'НОВОЕ!' : 'NEW!'}
      </span>
    </a>

    <!-- Stats bar -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-12 w-full max-w-3xl">
      {stats.map((stat) => {
        const inner = (
          <>
            <div class="text-2xl md:text-3xl font-bold text-white tabular-nums">{stat.value}</div>
            <div class="text-sm text-gray-400 mt-1">{stat.label}</div>
          </>
        );
        return stat.href ? (
          <a
            href={stat.href}
            class="glass rounded-xl px-6 py-4 text-center hover:bg-white/10 hover:border-white/20 transition-colors group"
          >
            {inner}
          </a>
        ) : (
          <div class="glass rounded-xl px-6 py-4 text-center">
            {inner}
          </div>
        );
      })}
    </div>

    <!-- Scroll indicator -->
    <a href="#about" class="mt-8 p-3 -m-3 text-gray-400 hover:text-gray-300 transition-colors animate-bounce" aria-label="Scroll to About section">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
      </svg>
    </a>
  </div>
</div>

<style>
  .skypeck-promo {
    background: linear-gradient(120deg, #4ade80, #a3e635, #facc15, #a3e635, #4ade80);
    background-size: 300% 300%;
    animation:
      skypeck-shimmer 4s ease-in-out infinite,
      skypeck-glow 2s ease-in-out infinite;
  }

  @keyframes skypeck-shimmer {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }

  @keyframes skypeck-glow {
    0%, 100% { box-shadow: 0 0 25px rgba(74, 222, 128, 0.5), 0 0 60px rgba(163, 230, 53, 0.25); }
    50% { box-shadow: 0 0 45px rgba(74, 222, 128, 0.9), 0 0 100px rgba(163, 230, 53, 0.5); }
  }
</style>
